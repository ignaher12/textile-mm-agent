# Agent wallet (use a fresh wallet dedicated to this project, holding minimal funds)
PRIVATE_KEY=

# Celo mainnet
CELO_RPC_URL=https://forno.celo.org

# Attribution tag (ERC-8021), issued on Loops House enrollment
ATTRIBUTION_TAG=

# LLM (NVIDIA Build, OpenAI-compatible API)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Telegram (create a bot with @BotFather, message it, then: npm run telegram:chat-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
